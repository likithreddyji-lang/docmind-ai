# DocMind Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file with real secrets!

# ==========================================
# 1. Database Configuration (MySQL)
# ==========================================
# For Cloud Deployment (e.g. Render with TiDB Cloud, Aiven, or Railway MySQL):
# Provide the full JDBC URL with SSL enabled:
# DB_URL=jdbc:mysql://your-mysql-host:3306/docmind?sslMode=REQUIRED&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=

# Or for local development with separate host/port:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=docmind
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ==========================================
# 2. Free AI API (Google Gemini)
# ==========================================
# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides:
# GEMINI_CHAT_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ==========================================
# 3. Security & JWT (REQUIRED, NO DEFAULT)
# ==========================================
# Must be at least 32 characters (256-bit) long for HMAC-SHA
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION=3600000

# ==========================================
# 4. Networking & CORS
# ==========================================
# Render automatically provides PORT (defaults to 8081 locally)
PORT=8081

# Origin URL of your deployed frontend (e.g., https://your-app.vercel.app)
# Supports comma-separated origins
FRONTEND_URL=http://localhost:5173,http://localhost:3000
